# =============================================================================
# Interactive AI Coach System — environment variables (SD §9.3)
# 複製為 .env 後填值。.env 不進 git。啟動時以 zod 驗證，缺必填即拒絕啟動。
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
# 對外網址（密碼重設連結用）
PUBLIC_BASE_URL=http://localhost:8080
# 只有位於反向代理之後才信任 X-Forwarded-For（1 = 信任一層代理）；直接對外時務必為 false
TRUST_PROXY=false

# --- PostgreSQL：四個角色對應四條連線（SD §8.6.3 / ADR-026）-------------------
DATABASE_URL=postgres://app_api:CHANGE_ME@localhost:5432/iac
DATABASE_URL_COACH=postgres://app_coach:CHANGE_ME@localhost:5432/iac
DATABASE_URL_WORKER=postgres://app_worker:CHANGE_ME@localhost:5432/iac
DATABASE_URL_RO=postgres://app_readonly:CHANGE_ME@localhost:5432/iac
# migration 執行者（superuser / owner），僅 tools/migrate.ts 使用
DATABASE_URL_MIGRATE=postgres://postgres:CHANGE_ME@localhost:5432/iac

# --- Session -----------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_LONG_RANDOM
SESSION_COOKIE_NAME=iac_session
CSRF_COOKIE_NAME=iac_csrf
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
# 僅在本機純 HTTP 除錯時設為 false
COOKIE_SECURE=true

# --- 登入保護 / 密碼重設（SD §8.1）------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=72

# --- License（SD §8.4）--------------------------------------------------------
# 供應方 public key 內建於程式碼（vendor-public-key.ts），不可由部署設定替換。
# 以下兩個覆寫只供開發／測試；NODE_ENV=production 時設定即拒絕啟動。
# LICENSE_PUBLIC_KEY_OVERRIDE=
# LICENSE_FINGERPRINT_OVERRIDE=
# 供應方線上啟用服務（未設定時只能離線啟用；正式環境須為 https）
LICENSE_ACTIVATION_URL=

# --- Elasticsearch / Object storage（Phase 3 教材與 AI 教練）------------------
# 教材檢索。未設定時教材停在「建立索引中」後標為失敗、AI 教練暫時無法使用，其他功能正常。
# 用 infra/compose 啟動時由 compose 自動指向內建 Elasticsearch（帳號 elastic），只需設定 ES_PASSWORD。
ES_PASSWORD=changeme
ELASTICSEARCH_URL=
# 二擇一：API key，或帳號密碼
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# 物件儲存（MinIO／S3 相容）：教材原始檔與擷取文字。未設定時教材上傳回 503，其他功能正常。
# 用 infra/compose 啟動時由 compose 自動指向內建 MinIO（http://object-storage:9000），這裡不必填；
# S3_ACCESS_KEY／S3_SECRET_KEY 同時是 MinIO 的 root 帳密，正式環境務必改掉預設值。
S3_ENDPOINT=
S3_BUCKET=iac-data
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- AI 教練（SD §6.19）：預設 none，資料出境須為刻意選擇（SA §22.1）--------
# 未設定時 AI 教練顯示「暫時無法使用」，其他功能正常。
#   Claude：AI_PROVIDER=anthropic，並填 AI_API_KEY（或 ANTHROPIC_API_KEY）；AI_MODEL 預設 claude-opus-5
#   OpenAI 相容服務（openai／azure_openai／internal）：須填 AI_BASE_URL（例如 https://gateway.example.com/v1）與 AI_MODEL
#   LiteLLM gateway＋各組織一把虛擬金鑰：AI_PROVIDER=litellm，填 AI_BASE_URL（LiteLLM 網址，含 /v1）、AI_MODEL（LiteLLM 上的模型名稱）
#     與 AI_KEY_ENCRYPTION_KEY；各組織的金鑰由平台管理員在「組織管理 → AI 金鑰」設定（加密存放），這裡不填 AI_API_KEY。
#     產生主金鑰：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#     主金鑰遺失或更換後，已存的組織金鑰都解不開，須重新設定——請與資料庫備份分開保管。
# 送出的內容只有問題、教材摘錄與學習情境摘要；不含姓名、email、學號。
AI_PROVIDER=none
AI_API_KEY=
AI_KEY_ENCRYPTION_KEY=
AI_BASE_URL=
AI_MODEL=
# Claude 的思考深度：low／medium／high（教練問答以回應速度為重，預設 medium）
AI_EFFORT=medium
AI_TIMEOUT_MS=60000
AI_EMBEDDING_MODEL=
# 非零保守預設；是調校旋鈕不是啟用閘門（ADR-029）
AI_DAILY_TOKEN_BUDGET_DEFAULT=200000

# --- SMTP（SD §8.10）---------------------------------------------------------
# 未設定 SMTP_HOST 則不寄信：開發環境把連結寫進 log；正式環境密碼重設／邀請信不會寄出
SMTP_HOST=
SMTP_PORT=587
# true = 隱式 TLS（通常 465）；false = 以 STARTTLS 升級
SMTP_SECURE=false
# 要求 STARTTLS，伺服器不支援即拒絕寄出；正式環境不可設為 false（信件含一次性 token）
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# 設了 SMTP_HOST 就必填，例如：Learning Platform <no-reply@example.com>
SMTP_FROM=
# SMTP 憑證由內部 CA 簽發時：以 NODE_EXTRA_CA_CERTS=/path/ca.pem 提供，不要關閉憑證驗證

# --- Worker ------------------------------------------------------------------
WORKER_QUEUES=ingest,ai,output
RETRIEVAL_MODE=hybrid
