# =============================================================================
# Interactive AI Coach System — environment variables (SD §9.3)
# 複製為 .env 後填值。.env 不進 git。啟動時以 zod 驗證，缺必填即拒絕啟動。
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

# --- PostgreSQL：四個角色對應四條連線（SD §8.6.3 / ADR-026）-------------------
DATABASE_URL=postgres://app_api:CHANGE_ME@localhost:5432/iac
DATABASE_URL_COACH=postgres://app_coach:CHANGE_ME@localhost:5432/iac
DATABASE_URL_WORKER=postgres://app_worker:CHANGE_ME@localhost:5432/iac
DATABASE_URL_RO=postgres://app_readonly:CHANGE_ME@localhost:5432/iac
# migration 執行者（superuser / owner），僅 tools/migrate.ts 使用
DATABASE_URL_MIGRATE=postgres://postgres:CHANGE_ME@localhost:5432/iac

# --- Session -----------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_LONG_RANDOM
SESSION_COOKIE_NAME=iac_session

# --- License（Ed25519 public key, PEM；產品只內建 public key）----------------
LICENSE_PUBLIC_KEY=

# --- Elasticsearch / Object storage（Phase 2 起必填）------------------------
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
S3_ENDPOINT=
S3_BUCKET=iac-data
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- AI Provider：預設 none，資料出境須為刻意選擇（SA §22.1）----------------
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
# 非零保守預設；是調校旋鈕不是啟用閘門（ADR-029）
AI_DAILY_TOKEN_BUDGET_DEFAULT=200000

# --- SMTP（未設定則僅 in-app 通知）------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Worker ------------------------------------------------------------------
WORKER_QUEUES=ingest,ai,output
RETRIEVAL_MODE=hybrid
